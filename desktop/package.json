{
  "name": "silan-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-dev-server.mjs",
    "build": "tsc && vite build",
    "test": "npm run test:resource-visibility && npm run test:navigation && npm run test:desktop-window && npm run test:shelf-interaction && npm run test:startup-sequence && npm run test:cover-generation && npm run test:language-review && npm run test:app-shell && npm run test:editor-session && npm run test:editor-workflows && npm run test:capture && npm run test:delivery-session && npm run test:deployment-readiness && npm run test:workspace-view && npm run test:onboarding && npm run test:workflow-guards && npm run test:content-settings && npm run test:traffic-insights && npm run test:media-layout && npm run test:lexical-editor && npm run test:card-presentation && npm run test:sidebar && npm run test:page-plugins && npm run test:themes",
    "test:capture": "esbuild src/lib/captureSubmission.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/silan-capture-submission-test.mjs && node --test /tmp/silan-capture-submission-test.mjs",
    "test:cover-generation": "node --experimental-strip-types --test src/lib/coverGeneration.test.mjs",
    "test:resource-visibility": "node --experimental-strip-types --test src/lib/resourceVisibility.test.mjs",
    "test:navigation": "node --experimental-strip-types --test src/lib/workspaceNavigation.test.mjs",
    "test:desktop-window": "node --experimental-strip-types --test src/lib/desktopWindow.test.mjs",
    "test:shelf-interaction": "node --experimental-strip-types --test src/lib/shelfInteractionMode.test.mjs",
    "test:startup-sequence": "esbuild src/lib/startupOrb.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/silan-startup-orb.test.mjs && node --experimental-strip-types --test src/lib/ApplicationBootstrap.test.mjs src/lib/bootPrimer.test.mjs src/lib/startupSequence.test.mjs /tmp/silan-startup-orb.test.mjs",
    "test:language-review": "node --experimental-strip-types --test src/lib/languageReviewWorkflow.test.mjs src/lib/reviewSuggestion.test.mjs",
    "test:editor-workflows": "node --experimental-strip-types --test src/lib/media.test.mjs src/lib/captureDraft.test.mjs src/lib/markdownBlockDiff.test.mjs src/lib/translationSyncWorkflow.test.mjs src/lib/autosaveQueue.test.mjs src/lib/editorRecovery.test.mjs src/lib/nativeFileDrag.test.mjs src/components/editor/interaction/CaretGeometry.test.mjs",
    "test:deployment-readiness": "node --experimental-strip-types --test src/lib/deploymentReadiness.test.mjs src/lib/remoteStatus.test.mjs",
    "test:workspace-view": "node --experimental-strip-types --test src/lib/markdownWorkspaceView.test.mjs",
    "test:onboarding": "node --experimental-strip-types --test src/lib/workspaceOnboardingModel.test.mjs",
    "test:workflow-guards": "node --experimental-strip-types --test src/lib/paidAiActions.test.mjs src/lib/sectionCommit.test.mjs src/lib/captureCopy.test.mjs",
    "test:content-settings": "esbuild src/app/settings/contentSettings.test.mjs --bundle --platform=node --format=esm --jsx=automatic --outfile=/tmp/silan-content-settings.test.mjs && node --test /tmp/silan-content-settings.test.mjs",
    "test:traffic-insights": "esbuild src/app/dashboard/trafficInsights.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/silan-traffic-insights-test.mjs && node --test /tmp/silan-traffic-insights-test.mjs",
    "test:lexical-editor": "node --conditions=development --experimental-strip-types --test src/components/editor/extensionPoints.test.mjs src/components/editor/model/ScientificMarkdownSyntax.test.mjs && esbuild scripts/verify-lexical-editor.ts --bundle --platform=node --format=esm --outfile=/tmp/silan-lexical-editor-verification.mjs && node /tmp/silan-lexical-editor-verification.mjs",
    "generate:icon": "python3 scripts/generate_icon.py && tauri icon src-tauri/icons/app-icon.png",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "build:desktop": "tauri build",
    "test:card-presentation": "node --experimental-strip-types --test src/lib/cardPresentation.test.mjs",
    "test:sidebar": "node --experimental-strip-types --test src/components/sidebar/SidebarFactory.test.mjs",
    "test:page-plugins": "node --experimental-strip-types --test src/plugins/PagePlugin.test.mjs && npm --prefix templates/page-plugin run check",
    "test:delivery-session": "esbuild src/app/delivery/DeliverySession.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/silan-delivery-session-test.mjs && node --test /tmp/silan-delivery-session-test.mjs",
    "test:editor-session": "esbuild src/app/authoring/EditorSession.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/silan-editor-session-test.mjs && node --test /tmp/silan-editor-session-test.mjs",
    "test:app-shell": "esbuild src/app/AppShell.test.mjs --bundle --platform=node --format=esm --jsx=automatic --outfile=/tmp/silan-app-shell-test.mjs && node --test /tmp/silan-app-shell-test.mjs",
    "test:media-layout": "node --experimental-strip-types --test src/components/editor/media/upstream/tests/*.test.ts",
    "test:themes": "esbuild src/theme/ThemeSession.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/silan-theme-tests.mjs && node --test /tmp/silan-theme-tests.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lexical/code": "0.49.0",
    "@lexical/extension": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/mdast": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/selection": "0.49.0",
    "@lexical/table": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@masonrykit/react": "^0.2.3",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "2.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "katex": "^0.19.0",
    "lexical": "0.49.0",
    "lucide-react": "^0.441.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^12.1.0",
    "micromark-extension-math": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/katex": "^0.16.8",
    "@types/mdast": "4.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "mdast-util-to-markdown": "^2.2.0",
    "micromark-util-types": "^2.0.3",
    "obsidian": "^1.8.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
