{
  "name": "silan-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-dev-server.mjs",
    "build": "tsc && vite build",
    "test": "npm run test:resource-visibility && npm run test:navigation && npm run test:desktop-window && npm run test:shelf-interaction && npm run test:startup-sequence && npm run test:cover-generation && npm run test:language-review && npm run test:editor-workflows && npm run test:deployment-readiness && npm run test:workspace-view && npm run test:onboarding && npm run test:lexical-editor",
    "test:cover-generation": "node --experimental-strip-types --test src/lib/coverGeneration.test.mjs",
    "test:resource-visibility": "node --experimental-strip-types --test src/lib/resourceVisibility.test.mjs",
    "test:navigation": "node --experimental-strip-types --test src/lib/workspaceNavigation.test.mjs",
    "test:desktop-window": "node --experimental-strip-types --test src/lib/desktopWindow.test.mjs",
    "test:shelf-interaction": "node --experimental-strip-types --test src/lib/shelfInteractionMode.test.mjs",
    "test:startup-sequence": "esbuild src/lib/startupOrb.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/silan-startup-orb.test.mjs && node --experimental-strip-types --test src/lib/bootPrimer.test.mjs src/lib/startupSequence.test.mjs /tmp/silan-startup-orb.test.mjs",
    "test:language-review": "node --experimental-strip-types --test src/lib/languageReviewWorkflow.test.mjs",
    "test:editor-workflows": "node --experimental-strip-types --test src/lib/markdownBlockDiff.test.mjs src/lib/translationSyncWorkflow.test.mjs src/lib/autosaveQueue.test.mjs src/lib/editorRecovery.test.mjs",
    "test:deployment-readiness": "node --experimental-strip-types --test src/lib/deploymentReadiness.test.mjs",
    "test:workspace-view": "node --experimental-strip-types --test src/lib/markdownWorkspaceView.test.mjs",
    "test:onboarding": "node --experimental-strip-types --test src/lib/workspaceOnboardingModel.test.mjs",
    "test:lexical-editor": "esbuild scripts/verify-lexical-editor.ts --bundle --platform=node --format=esm --outfile=/tmp/silan-lexical-editor-verification.mjs && node /tmp/silan-lexical-editor-verification.mjs",
    "generate:icon": "python3 scripts/generate_icon.py && tauri icon src-tauri/icons/app-icon.png",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "build:desktop": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lexical/code": "0.49.0",
    "@lexical/extension": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/mdast": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/selection": "0.49.0",
    "@lexical/table": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lexical": "0.49.0",
    "lucide-react": "^0.441.0",
    "mdast-util-from-markdown": "2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/mdast": "4.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
