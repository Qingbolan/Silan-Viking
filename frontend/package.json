{
  "name": "Silan-Personal-Website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:static": "tsc && node scripts/build-static.mjs",
    "build:nus": "npm run build:static -- /~silan-hu/ --canonical-origin https://silan.tech --canonical-base /",
    "build:seo": "tsc && vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "test:seo": "node --test scripts/seo-xml.test.mjs",
    "verify:seo": "node scripts/verify-static-release.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test:media": "esbuild scripts/verify-video-media.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=/tmp/silan-public-video-test.mjs && node /tmp/silan-public-video-test.mjs"
  },
